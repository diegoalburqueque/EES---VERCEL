# dependencies (cualquier profundidad: frontend/, api/, etc.)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca subir secretos (JWT_SECRET, credenciales de BD, etc.)
.env
.env.*
!.env.example

# Carpeta con documentación de la BD que incluye contraseñas reales (CONEXION.md, seed.sql
# con passwords de usuarios) — nunca a git. Match amplio porque ya se coló una vez por un
# nesting distinto (frontend/BD/...) que la regla anterior no cubría.
**/CONEXION.md
frontend/BD/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
